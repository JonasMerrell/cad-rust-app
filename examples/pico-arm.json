[
  {"tool": "new_document", "args": {"units": "mm"}},
  {"tool": "create_sketch", "args": {"plane": "top"}},
  {"tool": "sketch_add", "args": {"sketch_id": 1, "items": [{"type": "rect", "corner1": [0, 0], "corner2": [110, 70]}]}},
  {"tool": "add_feature", "args": {"kind": "extrude", "params": {"profiles": [{"sketch": 1}], "depth": 10}}},
  {"tool": "new_part_studio", "args": {"name": "Arm"}},
  {"tool": "create_sketch", "args": {"plane": "top"}},
  {"tool": "sketch_add", "args": {"sketch_id": 1, "items": [{"type": "rect", "corner1": [-7, -7], "corner2": [60, 7]}]}},
  {"tool": "add_feature", "args": {"kind": "extrude", "params": {"profiles": [{"sketch": 1}], "depth": 6}}},
  {"tool": "new_part_studio", "args": {"name": "Servo horn"}},
  {"tool": "create_sketch", "args": {"plane": "top"}},
  {"tool": "sketch_add", "args": {"sketch_id": 1, "items": [{"type": "rect", "corner1": [-4, -4], "corner2": [24, 4]}]}},
  {"tool": "add_feature", "args": {"kind": "extrude", "params": {"profiles": [{"sketch": 1}], "depth": 3}}},
  {"tool": "create_assembly", "args": {"name": "Arm and servo"}},
  {"tool": "assembly_insert", "args": {"assembly": 0, "studio": 0}},
  {"tool": "assembly_insert", "args": {"assembly": 0, "studio": 1, "position": [18, 12, 10]}},
  {"tool": "assembly_insert", "args": {"assembly": 0, "studio": 2, "position": [88, 50, 10]}},
  {"tool": "assembly_mate", "args": {"assembly": 0, "kind": "revolute", "name": "Arm pivot", "limits": [0, 90],
    "a": {"instance": 1, "origin": [18, 12, 10], "z": [0, 0, 1], "x": [1, 0, 0]},
    "b": {"instance": 2, "origin": [0, 0, 0], "z": [0, 0, -1], "x": [1, 0, 0]}}},
  {"tool": "assembly_mate", "args": {"assembly": 0, "kind": "revolute", "name": "Servo",
    "a": {"instance": 1, "origin": [88, 50, 10], "z": [0, 0, 1], "x": [1, 0, 0]},
    "b": {"instance": 3, "origin": [0, 0, 0], "z": [0, 0, -1], "x": [1, 0, 0]}}},
  {"tool": "create_pcb", "args": {"name": "Arm controller", "width": 80, "height": 60, "corner_radius": 2}},
  {"tool": "pcb_add_parts", "args": {"pcb": 0, "parts": [
    {"symbol": "PICO"},
    {"symbol": "M", "value": "TT"},
    {"symbol": "Q_NMOS", "value": "AO3400"},
    {"symbol": "D", "value": "1N5819"},
    {"symbol": "R", "value": "100"},
    {"symbol": "SW", "value": "Limit", "footprint": "Terminal_2P"},
    {"symbol": "RV", "value": "10k"},
    {"symbol": "SERVO", "value": "SG90"}
  ]}},
  {"tool": "pcb_connect", "args": {"pcb": 0, "nets": {
    "GND": ["U1.3", "U1.AGND", "Q1.2", "SW1.2", "RV1.1", "SV1.GND"],
    "VMOT": ["M1.1", "D1.1"],
    "DRAIN": ["M1.2", "Q1.3", "D1.2"],
    "GATE": ["U1.GP15", "R1.1"],
    "G": ["R1.2", "Q1.1"],
    "LIMIT": ["U1.GP14", "SW1.1"],
    "3V3": ["U1.3V3", "RV1.3"],
    "ANGLE": ["U1.GP26", "RV1.2"],
    "VBUS": ["U1.VBUS", "SV1.V+"],
    "SERVO": ["U1.GP16", "SV1.SIG"]
  }}},
  {"tool": "pcb_sim_setup", "args": {"pcb": 0,
    "ground": "GND",
    "sources": [{"name": "VMOT", "plus": "VMOT", "wave": 6}],
    "mcus": [{"part": "U1", "firmware": "examples/firmware/arm.uf2"}],
    "links": [
      {"part": "M1", "assembly": 0, "mate": "Arm pivot", "ratio": 5},
      {"part": "SW1", "assembly": 0, "mate": "Arm pivot"},
      {"part": "RV1", "assembly": 0, "mate": "Arm pivot"},
      {"part": "SV1", "assembly": 0, "mate": "Servo"}
    ],
    "probes": ["POS(M1)", "POS(SV1)", "I(M1)", "V(LIMIT)"]}},
  {"tool": "save_document", "args": {"path": "pico-arm-doc.json"}},
  {"tool": "simulate_pcb", "args": {"pcb": 0, "analysis": "tran", "stop": 1, "path": "pico-arm-sim.png", "pose_assembly_at": 0.25}},
  {"tool": "render_assembly", "args": {"assembly": 0, "view": "iso", "path": "pico-arm-assembly.png"}},
  {"tool": "render_pcb", "args": {"pcb": 0, "view": "schematic", "path": "pico-arm-schematic.png"}}
]
