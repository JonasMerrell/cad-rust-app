[
  {"tool": "new_document", "args": {"units": "mm"}},
  {"tool": "import_file", "args": {"path": "examples/zerotorque/Head.step", "name": "Head"}},
  {"tool": "set_part", "args": {"body": [1, 0], "name": "Head", "material": "Aluminium 6061"}},
  {"tool": "create_sketch", "args": {"plane": "top", "name": "Sight lines"}},
  {"tool": "sketch_add", "args": {"sketch_id": 2, "items": [
    {"type": "line", "from": [55, 8], "to": [55, 58]},
    {"type": "line", "from": [47, 12], "to": [47, 58]},
    {"type": "line", "from": [63, 12], "to": [63, 58]}]}},

  {"tool": "create_cam", "args": {"name": "OP1 top", "orient": "top", "origin": "stock_top_center",
    "stock": {"side": 3, "top": 3, "bottom": 3, "material": "Aluminium"},
    "post": "mach3", "max_rpm": 24000, "min_rpm": 12000}},
  {"tool": "cam_tool", "args": {"cam": 0, "kind": "flat", "name": "Ø6 flat, 3 flutes (aluminium)", "diameter": 6, "flutes": 3, "material": "carbide", "flute_length": 30, "stickout": 40, "coolant": true}},
  {"tool": "cam_tool", "args": {"cam": 0, "kind": "ball", "name": "Ø6 ball", "diameter": 6, "flutes": 2, "material": "carbide", "flute_length": 30, "stickout": 40, "coolant": true}},
  {"tool": "cam_tool", "args": {"cam": 0, "kind": "engrave", "name": "90° V-bit, sharp", "diameter": 6, "angle": 90, "tip_diameter": 0, "material": "carbide", "flute_length": 12, "stickout": 35, "coolant": true}},
  {"tool": "cam_tool", "args": {"cam": 0, "kind": "drill", "name": "Ø4.5 drill (M4 clearance)", "diameter": 4.5, "material": "carbide", "stickout": 40, "coolant": true}},
  {"tool": "cam_tool", "args": {"cam": 0, "kind": "drill", "name": "Ø4.2 drill (M5 tap)", "diameter": 4.2, "material": "carbide", "stickout": 30, "coolant": true}},
  {"tool": "cam_tool", "args": {"cam": 0, "preset": "M5 × 0.8 tap", "stickout": 30, "coolant": true}},

  {"tool": "cam_op", "args": {"cam": 0, "kind": "face", "tool": 1}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "adaptive", "tool": 1, "leave": 0.3, "leave_floor": 0.2}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "parallel", "tool": 2, "slope_max": 50, "stepover": 0.08}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "waterline", "tool": 2, "slope_min": 40, "stepdown": 0.3}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "trace", "tool": 3, "sketches": [2], "depth": 1, "name": "Sight lines"}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "deburr", "tool": 3, "chamfer": 0.4, "bottom": -10}},
  {"tool": "cam_op", "args": {"cam": 0, "kind": "drill", "tool": 4, "hole_min": 4.4, "hole_max": 4.6, "peck": 1.5}},
  {"tool": "cam_info", "args": {"cam": 0}},
  {"tool": "simulate_cam", "args": {"cam": 0, "path": "zt-op1-sim.png"}},

  {"tool": "create_cam", "args": {"name": "OP2 sole", "follows": "OP1 top", "orient": "bottom", "origin": "stock_top_center"}},
  {"tool": "cam_op", "args": {"cam": 1, "kind": "face", "tool": 1}},
  {"tool": "cam_op", "args": {"cam": 1, "kind": "bore", "tool": 1, "hole_min": 8.9, "hole_max": 14.1}},
  {"tool": "cam_op", "args": {"cam": 1, "kind": "drill", "tool": 5, "hole_min": 4.1, "hole_max": 4.3}},
  {"tool": "cam_op", "args": {"cam": 1, "kind": "tap", "tool": 6, "hole_min": 4.1, "hole_max": 4.3}},
  {"tool": "cam_op", "args": {"cam": 1, "kind": "deburr", "tool": 3, "chamfer": 0.4, "bottom": -6}},
  {"tool": "cam_info", "args": {"cam": 1}},
  {"tool": "simulate_cam", "args": {"cam": 1, "path": "zt-op2-sim.png"}},
  {"tool": "render_cam", "args": {"cam": 0, "path": "zt-op1-paths.png"}},
  {"tool": "export_gcode", "args": {"cam": 0, "path": "zt-op1.tap"}},
  {"tool": "export_gcode", "args": {"cam": 1, "path": "zt-op2.tap"}},
  {"tool": "export_setup_sheet", "args": {"cam": 0, "path": "zt-op1-sheet.html"}},
  {"tool": "save_document", "args": {"path": "zt-head-cam.json"}}
]
