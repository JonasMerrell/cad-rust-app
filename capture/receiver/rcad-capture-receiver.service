# systemd user unit. Install: cp rcad_capture_receiver.py to ~/.local/share/rcad-capture/ and this file to ~/.config/systemd/user/ then
#   systemctl --user daemon-reload && systemctl --user enable --now rcad-capture-receiver
[Unit]
Description=rCAD Capture photo receiver (photogrammetry uploads to ~/scans)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/rcad-capture/rcad_capture_receiver.py serve --root %h/scans --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
