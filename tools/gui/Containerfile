# Headless GUI rig for screenshots: Xvfb + software Vulkan/GL (lavapipe/llvmpipe).
FROM localhost/orca-gui
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mesa-vulkan-drivers libxkbcommon-x11-0 libxcursor1 libxrandr2 libxi6 && rm -rf /var/lib/apt/lists/*
